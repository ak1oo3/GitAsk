# ---- Database (pgvector) ----
# Local dev matches docker-compose.yml. On Railway/Render use the provided URL.
DATABASE_URL=postgresql://gitask:gitask@localhost:5432/gitask

# ---- Embeddings ----
# EMBEDDING_PROVIDER: "local" (sentence-transformers, no key) or "openai"
EMBEDDING_PROVIDER=local
# Local model (bge-small-en-v1.5 = 384 dims, fast; bge-base-en-v1.5 = 768 dims)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# If EMBEDDING_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- LLM answer synthesis ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Ingestion ----
# Where cloned repos are cached
CLONE_DIR=./.repos
# Max file size to index (bytes)
MAX_FILE_BYTES=1000000

# ---- Retrieval ----
TOP_K_VECTOR=20
TOP_K_FINAL=8
